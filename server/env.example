# Copy this file to ".env" (inside the server folder) and put your own keys in it.
# Keys are tried in order: when key 1 runs out of quota, key 2 takes over automatically (then key 3 ... up to 10).
GEMINI_API_KEY_1=paste-your-first-key-here
GEMINI_API_KEY_2=paste-your-second-key-here
# GEMINI_API_KEY_3=optional-third-key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
